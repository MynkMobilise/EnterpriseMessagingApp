# ============================================
# Frontend Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to Git (it's in .gitignore)
#
# IMPORTANT: Vite bakes these variables at BUILD TIME, not runtime
# For Production (Render): Set VITE_API_BASE_URL in Render BEFORE first build
# ============================================

# ============================================
# API Configuration
# ============================================
# Backend API base URL
# Local development: http://localhost:3003/api/v1
# Production: https://enterprise-messaging-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:3003/api/v1

# ============================================
# Production Notes (Render)
# ============================================
# For production deployment on Render:
# 1. Go to Render dashboard → Your Static Site → Environment
# 2. Add environment variable: VITE_API_BASE_URL
# 3. Set value to: https://enterprise-messaging-backend.onrender.com/api/v1
# 4. IMPORTANT: Set this BEFORE triggering the first build
# 5. If you set it after build, you must trigger a manual rebuild
# 6. After initial setup, auto-deploy will use this value automatically
