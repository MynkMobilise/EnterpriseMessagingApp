# ============================================
# Backend Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to Git (it's already in .gitignore)
#
# For Production (Render):
# - Set these values in Render dashboard Environment Variables
# - Do NOT use this .env file in production
# ============================================

# ============================================
# Server Configuration
# ============================================
PORT=3003
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=https://suchna.onmobilise.com

# ============================================
# Database Configuration (Local Development)
# ============================================
# For local development, use your local MySQL database
# For production (Render), use Railway MySQL credentials
DB_HOST=172.16.17.68
DB_PORT=3306
DB_NAME=whatsapp_business_platform
DB_USER=sdx_ind_uat_dbadmin
DB_PASSWORD=your_local_database_password

# Database Connection Pool (Optional)
# DB_POOL_MAX=10
# DB_POOL_MIN=2

# ============================================
# JWT Configuration
# ============================================
# Generate strong, random secrets for production
# Use: openssl rand -hex 64 (for 128 character hex string)
# Or: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# JWT Token Expiration (Optional)
# JWT_EXPIRES_IN=1h
# JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Encryption Key (CRITICAL)
# ============================================
# MUST be exactly 64 hex characters (32 bytes) for AES-256
# MUST be the SAME in local and production for data compatibility
# If different, encrypted API keys in database won't decrypt
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_hex_character_encryption_key_here_must_match_production

# ============================================

# ============================================
# Email/SMTP Configuration (Optional - Fallback)
# ============================================
# These are fallback values if not configured in database
# Most email configs are stored in database via Settings page
# Only set these if you want env-based SMTP fallback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_SECURE=false
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# EMAIL_FROM=noreply@yourcompany.com

# ============================================
# Security & Rate Limiting (Optional)
# ============================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# BCRYPT_ROUNDS=12

# ============================================
# File Upload Configuration (Optional)
# ============================================
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=10485760
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# Logging Configuration (Optional)
# ============================================
# LOG_LEVEL=info
# Options: error, warn, info, debug

# ============================================
# Production Notes (Render)
# ============================================
# For production deployment on Render:
# 1. Set all above variables in Render dashboard → Environment Variables
# 2. Use Railway MySQL credentials for DB_* variables:
#    - DB_HOST=shuttle.proxy.rlwy.net
#    - DB_PORT=17433
#    - DB_NAME=railway
#    - DB_USER=root
#    - DB_PASSWORD=your_railway_password
# 3. Update FRONTEND_URL to: https://enterprise-messaging-frontend.onrender.com
# 4. Update BACKEND_URL to: https://enterprise-messaging-backend.onrender.com
# 5. Update META_REDIRECT_URI to: https://enterprise-messaging-backend.onrender.com/api/v1/whatsapp-oauth/callback
# 6. ENCRYPTION_KEY MUST match your local .env value (for data compatibility)
# 7. JWT_SECRET and JWT_REFRESH_SECRET should be different from local (use strong random values)
