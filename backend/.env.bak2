# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=comm_db
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=2

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application
NODE_ENV=development
PORT=3003
API_URL=http://localhost:3003/api/v1
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key (CRITICAL - 64 hex chars, must be persistent across restarts)
ENCRYPTION_KEY=06a2c870ac2953e778ecf2b6b50e3df307ca4eae7b23fa2b568402bb243621ad

# Email (SMTP)
SMTP_HOST=mail.mobilisepro.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=testsmtp@mobilisepro.com
SMTP_PASSWORD=nl944Zr2kw65AIqLXvvSK18P
EMAIL_FROM=Suchna Management

# WhatsApp Business API
# Each organization configures its own Meta credentials via the UI:
#   Settings → WhatsApp API → Manual Configuration
# These are stored in `organization_settings` (encrypted at rest with
# ENCRYPTION_KEY) and consumed per-tenant by whatsappService.sendMessage.
# No env vars are needed here.

# SMS Provider (Twilio example)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Security
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
